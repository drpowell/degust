# Exclude git metadata
.git
.gitignore

# Exclude temporary and log files
log/*
tmp/*
!log/.keep
!tmp/.keep

# Exclude uploaded user data
uploads/*
!uploads/.keep

# Exclude node_modules (should be installed during docker build)
node_modules/
degust-frontend/node_modules/

# Exclude build artifacts and distribution files
# These are generated during the build process
degust-frontend/degust-dist/
degust-frontend/degust-dist-3.1/
degust-frontend/degust-dist-4.1/
docs/dist/

# Exclude secret files
.env

# Exclude IDE and OS specific files
.vscode/
.DS_Store
*.swp

# Exclude local database files
*.sqlite3
*.sqlite3-journal

# Exclude large tarballs
*.tar.gz

# Exclude testing reproduction scripts
repro_rce.rb
check_vulnerability.sh
